# Ejemplo de archivo .env
# Copia este archivo como .env y configura tus propias credenciales

# URL de conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/basedatos?sslmode=require

# Clave de API de Google para Gemini
GOOGLE_API_KEY=tu_clave_api_aqui

# Configuración CORS
# Para desarrollo: usa * para permitir todos los orígenes
# Para producción: especifica los dominios permitidos separados por comas
CORS_ALLOWED_ORIGINS=*
# Ejemplo producción: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tudominio.com

# Permitir credenciales (cookies, auth headers) en peticiones CORS
CORS_ALLOW_CREDENTIALS=true

# DEBUG mode (true para desarrollo, false para producción)
DEBUG=true
