# Configuración CORS
# Para desarrollo: permite todos los orígenes (desactivar seguridad)
# Para producción: especifica los dominios permitidos separados por comas
CORS_ALLOWED_ORIGINS=*
# Alternativa para producción: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tudominio.com

# Permitir credenciales (cookies, auth headers) en peticiones CORS
CORS_ALLOW_CREDENTIALS=true

# DEBUG mode (true para desarrollo, false para producción)
DEBUG=true